{
  "name": "yangon-tv-stream-server-1",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Single-instance Telegram MTProto to Cloudflare R2 streaming server for Yangon TV Bot 1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/lib-storage": "^3.850.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "teleproto": "^1.229.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
